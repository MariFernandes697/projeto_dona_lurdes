2️⃣ CRIAR O ARQUIVO salvar_edicao.php

Esse arquivo vai receber os dados do formulário e atualizar no banco de dados.

<?php
session_start();
include 'conexao.php';

if (!isset($_SESSION['id_usuario'])) {
    header("Location: login.php");
    exit;
}

$id_usuario = $_SESSION['id_usuario'];
$nome = $_POST['nome'];
$email = $_POST['email'];
$endereco = $_POST['endereco'];

// Atualiza os dados no banco
$sql = "UPDATE usuarios SET nome = ?, email = ?, endereco = ? WHERE id = ?";
$stmt = $conn->prepare($sql);
$stmt->bind_param("sssi", $nome, $email, $endereco, $id_usuario);

if ($stmt->execute()) {
    echo "<script>alert('Dados atualizados com sucesso!'); window.location='minha_conta.php';</script>";
} else {
    echo "Erro ao atualizar: " . $conn->error;
}
?>


